<?xml version="1.0"?>
<!--
    Connect IQ application manifest for WOD Coach - production UUID
    (docs/protocol.md section 0). manifest-beta.xml is identical except for
    the beta UUID; keep the two in sync.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="CoachApp"
        id="0508f6cf6f0040e59d7ed9f432688c46"
        launcherIcon="@Drawables.LauncherIcon"
        minSdkVersion="5.2.0"
        name="@Strings.AppName"
        type="watch-app"
        version="0.1.2">

        <!-- REQ-WP01: the MVP targets the Forerunner 965 only. -->
        <iq:products>
            <iq:product id="fr965"/>
        </iq:products>

        <!-- REQ-WP02: Fit = activity recording, Communications = phone
             messages, Sensor = enable the HR sensor for the session. -->
        <iq:permissions>
            <iq:uses-permission id="Fit"/>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
