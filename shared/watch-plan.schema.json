{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crossfitworkout.local/watch-plan.schema.json",
  "title": "WatchPlan (payload of plan.put) — docs/protocol.md §4",
  "type": "object",
  "additionalProperties": false,
  "required": ["sv", "id", "rev", "wid", "wr", "ti", "date", "tz", "u", "p"],
  "properties": {
    "sv": { "const": 1 },
    "id": { "$ref": "#/$defs/uuid" },
    "rev": { "$ref": "#/$defs/posInt" },
    "wid": { "$ref": "#/$defs/uuid" },
    "wr": { "$ref": "#/$defs/posInt" },
    "ti": { "$ref": "#/$defs/line" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "tz": { "type": "string", "minLength": 1 },
    "u": { "$ref": "#/$defs/massUnit" },
    "p": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/part" } }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "posInt": { "type": "integer", "minimum": 1 },
    "nonNegInt": { "type": "integer", "minimum": 0 },
    "line": { "type": "string", "maxLength": 28 },
    "massUnit": { "enum": ["kg", "lb"] },
    "mode": {
      "enum": ["for_time", "amrap", "emom", "tabata", "intervals", "max_effort", "strength_sets", "build_to_max", "manual"]
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "l", "n", "mode", "fb", "ln", "sc"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "l": { "type": "string", "minLength": 1, "maxLength": 3 },
        "n": { "$ref": "#/$defs/line" },
        "mode": { "$ref": "#/$defs/mode" },
        "fb": { "type": "boolean" },
        "ln": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/line" } },
        "seg": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/segment" } },
        "trk": { "enum": ["round", "mv"] },
        "mv": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/line" } },
        "rr": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/posInt" } },
        "rrc": { "const": true },
        "rl": { "type": "array", "maxItems": 200, "items": { "type": "string", "maxLength": 16 } },
        "rnd": { "$ref": "#/$defs/posInt" },
        "sets": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "$ref": "#/$defs/set" } },
        "att": { "type": "integer", "minimum": 1, "maximum": 30 },
        "sc": { "$ref": "#/$defs/score" },
        "ld": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/loadItem" } },
        "ra": { "$ref": "#/$defs/nonNegInt" },
        "lv": { "type": "string", "maxLength": 12 },
        "lvs": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 12 } }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "enum": ["strength_sets", "build_to_max"] } } },
          "then": { "required": ["sets"] },
          "else": { "required": ["seg"] }
        },
        {
          "if": { "properties": { "fb": { "const": true } } },
          "then": { "properties": { "mode": { "const": "manual" }, "sc": { "properties": { "man": { "const": true } } } } }
        }
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k", "lb", "ix"],
      "properties": {
        "k": { "enum": ["work", "rest", "open"] },
        "d": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "cap": { "type": "integer", "minimum": 1, "maximum": 7200 },
        "lb": { "type": "string", "maxLength": 12 },
        "ix": { "$ref": "#/$defs/nonNegInt" },
        "s": { "$ref": "#/$defs/nonNegInt" },
        "ic": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "k": { "enum": ["work", "rest"] } } }, "then": { "required": ["d"], "not": { "required": ["cap"] } } },
        { "if": { "properties": { "k": { "const": "open" } } }, "then": { "not": { "required": ["d"] } } }
      ]
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["u", "c"],
      "properties": {
        "v": { "type": "number", "minimum": 0, "maximum": 1100 },
        "u": { "$ref": "#/$defs/massUnit" },
        "c": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nm", "rx"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "nm": { "type": "string", "maxLength": 20 },
        "mv": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "r": { "type": "integer", "minimum": 1, "maximum": 99999 },
        "rx": { "type": "string", "maxLength": 8 },
        "w": { "$ref": "#/$defs/load" },
        "bw": { "type": "boolean" },
        "rest": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "ty": { "enum": ["warmup", "working", "top", "backoff", "amrap"] },
        "nt": { "$ref": "#/$defs/line" }
      },
      "not": { "required": ["w", "bw"] }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ty", "rv"],
      "properties": {
        "ty": { "enum": ["time", "rounds_reps", "reps", "load", "calories", "distance", "minutes_reps", "completion", "text", "none"] },
        "rv": { "$ref": "#/$defs/posInt" },
        "cap": { "enum": ["reps", "text"] },
        "du": { "enum": ["m", "km", "mi", "ft", "yd"] },
        "man": { "type": "boolean" },
        "agg": { "enum": ["sum", "min", "each"] }
      }
    },
    "loadItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nm", "u", "c"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "nm": { "type": "string", "maxLength": 20 },
        "v": { "type": "number", "minimum": 0, "maximum": 1100 },
        "u": { "$ref": "#/$defs/massUnit" },
        "c": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    }
  }
}
